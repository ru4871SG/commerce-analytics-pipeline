# Copy to .env (git-ignored) and fill in for a real deployment. For the local demo use
# .env.local.example instead: scripts/local.sh reads either one, and no real system is needed.
# The same variables configure Airflow and Dagster: without Airflow, crm_pipeline reads the
# AIRFLOW_CONN_* values directly.
#
# Nothing here is needed for the DAG to appear in Airflow; connections are needed to run it.

# Snowflake: the bronze loader writes RAW.CRM with it, and dbt builds ANALYTICS with it.
# Key-pair auth shown. For password auth, set "password" and leave out private_key_content.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "AIRFLOW_SVC", "extra": {"account": "myorg-myaccount", "warehouse": "TRANSFORMING_WH", "role": "TRANSFORMER", "database": "RAW", "private_key_content": "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"}}'

# The server that holds every brand's CRM database (read-only user is enough).
AIRFLOW_CONN_CRM_SOURCE_POSTGRESQL='postgresql://readonly_user:password@crm-db.example.com:5432'

# Optional: a service that refreshes a brand's CRM export before it is copied. When this
# connection is absent the export step logs that it is skipping and uses the database as it is.
# AIRFLOW_CONN_CRM_EXPORT_API='{"conn_type": "http", "password": "<shared secret>", "extra": {"base_url": "http://export.example.com:82", "endpoint": "/api/export-crm", "secret_header": "<header that carries the secret>"}}'

# the ECB's daily euro exchange rates, for revenue at actual rates beside the constant ones.
# AIRFLOW_CONN_ECB_FX_API='{"conn_type": "http", "extra": {"base_url": "https://data-api.ecb.europa.eu", "endpoint": "/service/data/EXR"}}'

# CDC of the orders table, from PostgreSQL's write-ahead log
# AIRFLOW_CONN_CRM_SOURCE_CDC='postgresql://crm_cdc_reader:password@crm-db.example.com:5432'

# Optional: Slack alerts when a task fails for good.
# AIRFLOW_CONN_SLACK_WEBHOOK='{"conn_type": "slackwebhook", "password": "https://hooks.slack.com/services/..."}'

# How far before the last load each incremental load reads again, for changes that commit late
# (default 60 minutes; crm_pipeline/config.py).
# CRM_INCREMENTAL_LOOKBACK_MINUTES=60

# Build into ANALYTICS.SILVER / ANALYTICS.GOLD (prod) or into your own schema (dev).
# AIRFLOW_VAR_CRM_DBT_TARGET=prod
# AIRFLOW_VAR_CRM_DBT_DEV_SCHEMA=dbt_ruddy
