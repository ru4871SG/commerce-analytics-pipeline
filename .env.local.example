# Local connections for scripts/local.sh. `scripts/local.sh install` copies this file to .env
# (git-ignored) and adds a random AIRFLOW_PASSWORD and SUPERSET_PASSWORD for the UI logins.
# Without .env, local.sh reads this file directly. Nothing here points at a real system.
AIRFLOW_CONN_CRM_SOURCE_POSTGRESQL='postgresql://airflow_reader:airflow_reader@127.0.0.1:5433'
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "fake", "password": "snow", "extra": {"account": "fakesnow", "host": "127.0.0.1", "port": 64616, "protocol": "http", "database": "RAW", "warehouse": "TRANSFORMING_WH", "role": "TRANSFORMER", "load_method": "insert"}}'
AIRFLOW_VAR_CRM_DBT_TARGET=emulator
AIRFLOW_VAR_CRM_DBT_DEV_SCHEMA=dbt_dev

# Demo mode: crm_daily_activity writes a day of shop activity every morning with this user, and
# crm_executive_report runs when it is done. A real deployment has neither.
CRM_SIMULATE_ACTIVITY=true
AIRFLOW_CONN_CRM_SOURCE_WRITER='postgresql://activity_simulator:activity_simulator@127.0.0.1:5433'

# The ECB's daily euro exchange rates
AIRFLOW_CONN_ECB_FX_API='{"conn_type": "http", "extra": {"base_url": "https://data-api.ecb.europa.eu", "endpoint": "/service/data/EXR"}}'

# CDC of the orders table: a role that may read the write-ahead log
AIRFLOW_CONN_CRM_SOURCE_CDC='postgresql://crm_cdc_reader:crm_cdc_reader@127.0.0.1:5433'
